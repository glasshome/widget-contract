{
  "$comment": "What a widget built for SDK major 2 may import from each host-provided module. scripts/build-guest.ts exposes exactly the listed names, so the bundler drops the rest, and src/shared/widget-surface.ts fails a widget bundle that imports anything else. \"entry\" is the package's whole entry less its withheld names. Every runtime export of solid-js and @solidjs/web is listed or withheld with its reason. @glasshome/ui/solid, @glasshome/sync-layer and iconify-icon are absent: 2.0 removes direct ui and iconify-icon imports (widget-sdk deprecations direct-ui-import, iconify-icon), and widget builds already refuse sync-layer.",
  "solid": {
    "solid-js": "2.0.3",
    "@solidjs/web": "2.0.3"
  },
  "reasons": {
    "server": "runs only on a server; in the browser build it is a stub or throws",
    "hydration": "resumes server-rendered HTML, which a realm never receives",
    "server-components": "server components and their link claims, which a realm never runs",
    "page-assets": "writes the page head or loads link, script and style assets, which the mirror never carries",
    "dev": "dev and observe tooling, undefined or inert in the production build",
    "realm-global": "configures the runtime every co-tenant widget in the realm shares",
    "internal": "plumbing between solid-js and @solidjs/web, absent from solid-js's public types",
    "deprecated": "deprecated in widget-sdk 1.x and removed in 2.0.0 (widget-sdk src/deprecations.ts)"
  },
